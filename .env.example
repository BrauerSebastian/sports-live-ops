# Server-only database credentials. Never expose DATABASE_URL through NEXT_PUBLIC_*.
DATABASE_URL="postgresql://sports_live_ops:sports_live_ops@localhost:5432/sports_live_ops?schema=public"

# Server-only NextAuth configuration.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-local-secret"

# Public canonical URL used for metadata, robots.txt and sitemap.xml.
SITE_URL="http://localhost:3000"

# Optional public Google Analytics measurement ID (for example G-XXXXXXXXXX).
# This identifier is intentionally public and analytics load only after explicit consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
